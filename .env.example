# Email Configuration
# 1. Enter your Gmail address below
GMAIL_USER=your.email@gmail.com

# 2. Get an App Password from Google:
#    - Go to your Google Account (myaccount.google.com)
#    - Security -> 2-Step Verification (Must be turned ON)
#    - Scroll to the bottom and click "App passwords"
#    - Name it "CareerOps" and copy the 16-character code
#    - Paste it below (no spaces)
GMAIL_APP_PASSWORD=xxxx_xxxx_xxxx_xxxx
